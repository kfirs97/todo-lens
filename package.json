{
  "name": "todo-lens",
  "displayName": "TODO Lens — Better Comments & TODO Tree",
  "version": "0.1.0",
  "publisher": "branchline",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node esbuild.mjs --tests && node --test dist-test/*.test.js",
    "package": "node esbuild.mjs --production && vsce package --no-dependencies"
  },
